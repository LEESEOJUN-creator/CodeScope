# 로컬 실행용 환경변수 템플릿.
# 사용법: cp .env.example .env 후 값을 채운다(.env는 .gitignore 대상 — 절대 커밋 금지).
# Spring이 기동 시 자동으로 읽는다(application.yaml spring.config.import).
# 값에 따옴표를 붙이지 말 것 — properties 형식이라 따옴표까지 값으로 들어간다.

# ── 필수 ──────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
# HS256용 256bit 이상 Base64 문자열. 생성: openssl rand -base64 32
JWT_SECRET=

# ── Claude API ────────────────────────
# 발급: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# claude-opus-5-5(기본) | claude-sonnet-5-5
CLAUDE_MODEL=claude-opus-5-5

# ── 선택 ──────────────────────────────
# claude(기본) | ollama | stub
# LLM_GENERATION_PROVIDER=claude
